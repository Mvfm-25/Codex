// t09 — sequência de Collatz (lê n). Teste com t09_collatz.entrada
int n;
int passos;

void main() {
    write("Informe um numero: ");
    read(n);
    passos = 0;
    while (n != 1) {
        if (n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;
        passos = passos + 1;
        write("N: ", n);
    }
    write("passos: ", passos);
}
